# Copie este archivo a `.env` y complete la API Key. `.env` esta en .gitignore.
#
# Hay UNA sola API Key para todos los casos —desarrollo, build y Capacitor— y el
# transporte se elige solo:
#
#   - Desarrollo: las llamadas pasan por el dev-server de Vite, que las reenvia al proxy.
#     No es por la clave (el navegador la manda igual) sino porque qr-banco-economico no
#     declara CORS y un fetch directo desde localhost seria rechazado por el navegador.
#   - Build / Capacitor: no hay dev-server, las llamadas salen directo a VITE_QR_BASE_URL.
#
# ATENCION: la clave queda dentro del bundle compilado. Es una decision tomada para esta
# demo. En el empaquetado nativo se traslada al llavero del dispositivo, lo que la protege
# en reposo pero no la hace irrecuperable del APK. Una aplicacion real debe emitir estas
# llamadas desde un backend propio. Ver el README.

# ─── Proxy qr-banco-economico ────────────────────────────────────────────────
# API Key del suscriptor. En un emulador de Android, `localhost` es el propio telefono:
# use 10.0.2.2 para alcanzar la maquina anfitriona.
VITE_QR_API_KEY="<GUID de la API Key del suscriptor>"
# Ambiente de la clave. El proxy las emite por ambiente y rechaza una de otro.
VITE_QR_ENVIRONMENT="prd"
VITE_QR_BASE_URL="http://localhost:5000"
# Solo si el suscriptor tiene varias cuentas de Baneco concedidas y ninguna predeterminada.
# VITE_QR_BANECO_ACCOUNT="recaudos-01"

# ─── Parametros del cobro ────────────────────────────────────────────────────
# Sucursal que recauda. Viaja en el QR y permite ubicar el cobro en el reporte.
VITE_QR_BRANCH_CODE="0001"
VITE_QR_CURRENCY="BOB"
# Dias de vigencia del QR emitido.
VITE_QR_DUE_DAYS="1"
# Segundos entre una verificacion del cobro y la siguiente.
VITE_QR_POLL_SECONDS="60"
# Tope de espera de una llamada al proxy, en milisegundos.
VITE_QR_TIMEOUT_MS="30000"
# Prefijo del transactionId, que el proxy exige unico por suscriptor.
VITE_QR_TX_PREFIX="DEMO"

# ─── Impresora termica ───────────────────────────────────────────────────────
# Ancho del PAPEL en milimetros: 80 en las portatiles de recibos, 58 en las de bolsillo.
VITE_PRINTER_PAPER_MM="80"

# ─── Funcionalidades ─────────────────────────────────────────────────────────
# Estado inicial del cobro por QR en un equipo que nunca guardo configuracion.
VITE_FEATURE_PAGO_QR="true"
